#!/bin/sh
# Pre-push hook: the fast part of scripts/ci.sh (rendering.md section 6
# item 1). Runs the format check, clippy with warnings as errors, the
# vocabulary lint, and the library unit tests, and refuses the push if any
# of them fails. The full scripts/ci.sh (headless renders, the budget test,
# the browser builds) still runs before every commit is accepted.
#
# Installed by scripts/install-hooks.sh, which points core.hooksPath here.
# Git passes the remote name and URL as arguments and the refs on standard
# input; this hook checks the working tree and ignores both.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

run() {
    printf '\n==> pre-push: %s\n' "$*"
    if ! "$@"; then
        printf '\npre-push: "%s" failed, push refused\n' "$*" >&2
        exit 1
    fi
}

run cargo fmt --all -- --check
run cargo clippy --workspace --all-targets -- -D warnings
run sh scripts/vocab-lint.sh
run cargo test --workspace --lib

printf '\npre-push ok\n'
